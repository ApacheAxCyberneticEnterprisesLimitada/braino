# Generate independent values with: openssl rand -base64 32
DOCO_ENCRYPTION_KEY=
DOCO_POSTGRES_PASSWORD=
BRAINO_SETUP_TOKEN=
BRAINO_CODELINKER_API_TOKEN=
BRAINO_PLUGIN_HOST_API_TOKEN=

# Optional local model runtime. Start it with:
# docker compose --profile models up -d
# BRAINO_OLLAMA_IMAGE=ollama/ollama:0.40.16
# BRAINO_OLLAMA_EMBEDDING_MODEL=embeddinggemma
# BRAINO_PLUGIN_LOCAL_NETWORK_HOSTS=ollama:11434

# Plain HTTP is the default supported local path.
DOCO_PUBLIC_HOST=http://localhost:3000
DOCO_HTTP_PORT=3000

# Optional: start `docker compose --profile tls up -d` with a DNS name that
# resolves to this host, then make the browser-visible origin match it.
# DOCO_HOST=doco.example.com
# DOCO_PUBLIC_HOST=https://doco.example.com

# Optional: use a released image instead of building this checkout.
# DOCO_IMAGE=ghcr.io/brainoinc/braino:latest
# BRAINO_CODELINKER_IMAGE=ghcr.io/brainoinc/braino-codelinker:latest
# BRAINO_PLUGIN_HOST_IMAGE=ghcr.io/brainoinc/braino-plugin-host:latest
