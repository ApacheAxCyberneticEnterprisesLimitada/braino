{
  "name": "@doco/db",
  "version": "0.1.19",
  "type": "module",
  "description": "Postgres adapter for Braino source-of-truth storage.",
  "license": "MPL-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "import": "./dist/test-support.js"
    }
  },
  "sideEffects": false,
  "files": ["dist", "src/schema.sql", "migrations"],
  "scripts": {
    "build": "node scripts/embed-migrations.mjs && tsc -p tsconfig.json && cp src/schema.sql dist/schema.sql",
    "migrate": "node dist/migrate.js",
    "snapshot:retrieval": "tsx scripts/retrieval-snapshot.ts",
    "typecheck": "node scripts/embed-migrations.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "node scripts/embed-migrations.mjs && vitest run --passWithNoTests"
  },
  "dependencies": {
    "@doco/shared": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10"
  }
}
