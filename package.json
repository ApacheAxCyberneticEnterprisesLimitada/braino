{
  "name": "@doco/core",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "The open-source core of Braino.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && pnpm --filter @doco/web build",
    "build:packages": "pnpm --workspace-concurrency=1 --filter='./packages/*' --filter='!@doco/web' build",
    "audit": "pnpm audit --audit-level high",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "conformance": "bash scripts/conformance.sh",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "5.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
