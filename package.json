{
  "name": "@doco/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The open-source core of Doco.",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --workspace-concurrency=1 -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.4.6",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
